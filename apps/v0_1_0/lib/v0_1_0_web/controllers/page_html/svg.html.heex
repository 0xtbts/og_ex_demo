<main class="mx-auto max-w-6xl px-6 py-20">
  <div class="grid items-end gap-10 lg:grid-cols-[1fr_auto]">
    <section>
      <p class="font-mono text-sm font-bold uppercase tracking-[0.2em] text-sky-600">
        Vector signal · 1200 × 630
      </p>
      <h1 class="mt-5 max-w-4xl text-6xl font-black leading-[0.92] tracking-[-0.055em] text-[#071A52] sm:text-8xl">
        {@title}
      </h1>
      <p class="mt-7 max-w-2xl text-xl leading-8 text-slate-600">
        {@description}
      </p>
    </section>

    <div class="flex h-36 w-36 rotate-6 items-center justify-center rounded-[2.5rem] bg-[#FFCB47] text-center font-mono text-sm font-black text-[#071A52] shadow-xl shadow-amber-300/30">
      image/<br />svg+xml
    </div>
  </div>

  <nav class="mt-14 flex flex-wrap gap-5 text-sm font-bold">
    <a class="text-sky-700 underline decoration-2 underline-offset-4" href={~p"/square-svg"}>
      Open square SVG
    </a>
    <a class="text-slate-700 underline decoration-2 underline-offset-4" href={~p"/"}>
      Back to PNG demos
    </a>
  </nav>
</main>
