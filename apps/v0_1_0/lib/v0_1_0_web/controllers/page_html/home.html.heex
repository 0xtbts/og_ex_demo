<main class="mx-auto max-w-3xl px-6 py-24">
  <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
    OgEx demo
  </p>
  <h1 class="mt-4 text-5xl font-bold tracking-tight text-slate-950">
    {@title}
  </h1>
  <p class="mt-6 text-xl leading-8 text-slate-600">
    {@description}
  </p>
  <p class="mt-10 rounded-xl bg-slate-100 p-5 font-mono text-sm text-slate-700">
    Inspect this page's source, copy the generated og:image URL, and open it to
    request the card PNG from this same route.
  </p>
  <nav class="mt-8 grid gap-4 sm:grid-cols-3" aria-label="OgEx card demos">
    <.link
      :for={
        {path, label, format} <- [
          {~p"/square", "Square card", "600 × 600 PNG"},
          {~p"/svg", "Wide SVG card", "1200 × 630 SVG"},
          {~p"/square-svg", "Square SVG card", "600 × 600 SVG"}
        ]
      }
      navigate={path}
      class="group rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-indigo-300 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
    >
      <span class="block font-semibold text-slate-950 group-hover:text-indigo-700">
        {label}
      </span>
      <span class="mt-1 block text-sm text-slate-500">{format}</span>
    </.link>
  </nav>
</main>
