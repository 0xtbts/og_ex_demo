<main class="mx-auto grid min-h-[72vh] max-w-5xl items-center gap-14 px-6 py-20 lg:grid-cols-[22rem_1fr]">
  <div class="aspect-square rounded-[3rem] bg-[#3C1642] p-9 text-[#B7F7D8] shadow-2xl shadow-purple-950/20">
    <p class="font-mono text-xs font-bold uppercase tracking-[0.2em]">SVG specimen</p>
    <p class="mt-16 font-serif text-5xl font-bold leading-[0.92]">
      Always crisp.<br />Never loud.
    </p>
    <div class="mt-16 h-5 w-5 rounded-full bg-[#FFD166]"></div>
  </div>

  <section>
    <p class="font-mono text-sm font-bold uppercase tracking-[0.2em] text-[#7A2C85]">
      Compact vector · 600 × 600
    </p>
    <h1 class="mt-5 font-serif text-6xl font-bold leading-[0.95] text-[#3C1642]">
      {@title}
    </h1>
    <p class="mt-7 max-w-xl text-xl leading-8 text-slate-600">
      {@description}
    </p>
    <nav class="mt-10 flex flex-wrap gap-5 text-sm font-bold">
      <a class="text-[#7A2C85] underline decoration-2 underline-offset-4" href={~p"/svg"}>
        Open wide SVG
      </a>
      <a class="text-slate-700 underline decoration-2 underline-offset-4" href={~p"/square"}>
        Open square PNG
      </a>
    </nav>
  </section>
</main>
