<main class="mx-auto max-w-3xl px-6 py-24">
  <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">
    OgEx demo
  </p>
  <h1 class="mt-4 text-5xl font-bold tracking-tight text-slate-950">
    {@title}
  </h1>
  <p class="mt-6 text-xl leading-8 text-slate-600">
    {@description}
  </p>
  <p class="mt-10 rounded-xl bg-slate-100 p-5 font-mono text-sm text-slate-700">
    Inspect this page's source, copy the generated og:image URL, and open it to
    request the card PNG from this same route.
  </p>
  <a
    href={~p"/square"}
    class="mt-8 inline-flex rounded-full bg-indigo-700 px-5 py-3 font-semibold text-white transition hover:bg-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
  >
    View the square card
  </a>
</main>
